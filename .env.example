VITE_API_BASE_URL=https://api.pythoncourse.me
VITE_PORTAL_ORIGIN=https://campus.pythoncourse.me

# Dev-server only. Target of the `/api` proxy in `npm run dev` (NOT a VITE_ var,
# so it is never bundled into the production build). Defaults to the LOCAL
# backend (http://127.0.0.1:8000) when unset, so local dev and live-acceptance
# never write to prod data or spend prod-LLM budget. Set it to the production
# API URL ONLY when you deliberately work against LIVE data.
# CS_DEV_API_PROXY_TARGET=https://api.pythoncourse.me
